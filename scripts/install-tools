#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
[[ "$(uname -s)" == Linux ]]
arch=$(uname -m)
case "$arch" in
  x86_64)
    task_sha=680859dbb4d881a9c72d4d9a8f510825450849af8567deacd7302c01124416fb
    gitleaks_arch=x64
    gitleaks_sha=79a3ab579b53f71efd634f3aaf7e04a0fa0cf206b7ed434638d1547a2470a66e
    actionlint_arch=amd64
    actionlint_sha=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
    ;;
  aarch64)
    task_sha=d7189d439d4a6058e39e1b2acd7c8b27acd4856691b408f23b242e4294e1df5b
    gitleaks_arch=arm64
    gitleaks_sha=b4cbbb6ddf7d1b2a603088cd03a4e3f7ce48ee7fd449b51f7de6ee2906f5fa2f
    actionlint_arch=arm64
    actionlint_sha=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6
    ;;
  *) printf 'Unsupported Linux architecture: %s\n' "$arch" >&2; exit 1 ;;
esac

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
mkdir -p .cache/bin .cache/downloads
install_release() {
  local binary=$1 url=$2 digest=$3
  local archive=".cache/downloads/${url##*/}"
  if [[ ! -f "$archive" ]] || ! printf '%s  %s\n' "$digest" "$archive" | sha256sum --check --status; then
    curl --fail --silent --show-error --location "$url" -o "$scratch/archive"
    printf '%s  %s\n' "$digest" "$scratch/archive" | sha256sum --check --status
    mv "$scratch/archive" "$archive"
  fi
  tar -xzf "$archive" -C "$scratch" "$binary"
  install -m 0755 "$scratch/$binary" ".cache/bin/$binary"
}
install_release gitleaks "https://github.com/gitleaks/gitleaks/releases/download/v8.30.0/gitleaks_8.30.0_linux_$gitleaks_arch.tar.gz" "$gitleaks_sha"
install_release actionlint "https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_$actionlint_arch.tar.gz" "$actionlint_sha"
install_release task "https://github.com/go-task/task/releases/download/v3.54.0/task_linux_$actionlint_arch.tar.gz" "$task_sha"
