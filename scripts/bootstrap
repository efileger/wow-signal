#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export UV_CACHE_DIR="$PWD/.cache/uv"
export UV_PYTHON_DOWNLOADS=never

require_version() {
  if [[ "$2" != "$3" ]]; then
    printf 'Expected %s %s, found %s\n' "$1" "$3" "$2" >&2
    exit 1
  fi
}

require_version Node "$(node --version)" "v$(cat .node-version)"
require_version npm "$(npm --version)" 11.19.1
require_version Python "$(python3 --version)" "Python $(cat .python-version)"
require_version uv "$(uv --version | cut -d ' ' -f 2)" 0.13.9

npm ci --ignore-scripts --no-audit
uv sync --locked --python python3
bash scripts/install-tools
mkdir -p .cache/config

hooks_path=$(git config --get core.hooksPath || true)
if [[ -z "$hooks_path" || "$hooks_path" == .githooks ]]; then
  git config --local core.hooksPath .githooks
else
  printf 'Existing Git hooks at %s. Include .githooks/pre-commit there before committing.\n' "$hooks_path" >&2
  exit 1
fi
