#!/usr/bin/env bash
set -euo pipefail

case "${1:-tree}" in
  staged) .cache/bin/gitleaks git --pre-commit --staged --redact=100 ;;
  tree)
    scratch=$(mktemp -d)
    trap 'rm -rf "$scratch"' EXIT
    git ls-files -z --cached --others --exclude-standard --deduplicate |
      while IFS= read -r -d '' path; do
        if [[ -f "$path" && ! -L "$path" ]]; then
          install -D -m 0600 -- "$path" "$scratch/$path"
        fi
      done
    .cache/bin/gitleaks dir --redact=100 -- "$scratch"
    ;;
  history)
    git merge-base --is-ancestor "$2" HEAD
    .cache/bin/gitleaks git --log-opts="$2..HEAD" --redact=100
    ;;
  *) printf 'Usage: %s {staged|tree|history BASE}\n' "$0" >&2; exit 2 ;;
esac
